{
  "kind": "collectionType",
  "collectionName": "mew_rewards_campaigns",
  "info": {
    "singularName": "mew-rewards-campaign",
    "pluralName": "mew-rewards-campaigns",
    "displayName": "MEW-rewards-campaign",
    "description": "MEW Rewards campaigns: list cards (/rewards) and detail pages (/rewards/:id)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "cta": {
      "type": "string",
      "required": true
    },
    "campaign_status": {
      "type": "enumeration",
      "enum": [
        "new",
        "ending",
        "permanent",
        "ended"
      ],
      "default": "new",
      "required": true
    },
    "products": {
      "type": "component",
      "repeatable": true,
      "component": "rewards.platform",
      "required": true,
      "min": 1
    },
    "long_description": {
      "type": "text"
    },
    "reward_info": {
      "type": "component",
      "repeatable": false,
      "component": "rewards.reward-info"
    },
    "how_to_earn": {
      "type": "component",
      "repeatable": true,
      "component": "rewards.how-to-earn-step"
    },
    "terms": {
      "type": "component",
      "repeatable": false,
      "component": "rewards.terms"
    }
  }
}
